[Unit]
Description=Omarchy YouTube Music plugin playback backend
Documentation=https://github.com/felixzsh/omarchy-ytmusic
Requires=omarchy-ytmusic.socket
After=omarchy-ytmusic.socket graphical-session.target sound.target
Wants=sound.target

[Service]
Type=simple
Environment=PULSE_LATENCY_MSEC=30
Environment=OMARCHY_YTMUSIC_NODE=__NODE_BINARY__
ExecStart=%h/.local/share/omarchy-ytmusic/venv/bin/python %h/.local/lib/omarchy-ytmusic/server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=8
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

# Socket-activated: enable omarchy-ytmusic.socket, never this unit. The backend
# starts on the first connection and exits again after the configured idle time.
